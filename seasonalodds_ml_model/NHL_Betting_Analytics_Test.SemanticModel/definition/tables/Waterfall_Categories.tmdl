table Waterfall_Categories
	lineageTag: 341a2153-358a-4457-9595-81ccc8e8498c

	measure 'Waterfall Value' = ```
			
			SWITCH(
			    SELECTEDVALUE(Waterfall_Categories[Step]),
			    "Capital Wagered", -1 * [Total Capital Spent],
			    "Gross Payouts Returned", [Total Capital Spent] + [Total Net Gain],
			    "Net Profit", [Total Net Gain]
			)
			
			```
		lineageTag: fa3e7552-d93c-441b-ad30-c1ea39307be1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Step
		lineageTag: b6d91a33-16ea-4a21-ab12-584dac2cefc9
		summarizeBy: none
		isNameInferred
		sourceColumn: [Step]

		annotation SummarizationSetBy = Automatic

	column SortOrder
		formatString: 0
		lineageTag: c422d0d6-e067-4546-b033-1d7a6ddc0e2c
		summarizeBy: sum
		isNameInferred
		sourceColumn: [SortOrder]

		annotation SummarizationSetBy = Automatic

	partition Waterfall_Categories = calculated
		mode: import
		source =
				DATATABLE(
				    "Step", STRING,
				    "SortOrder", INTEGER,
				    {
				        {"Capital Wagered", 1},
				        {"Gross Payouts Returned", 2},
				        {"Net Profit", 3}
				    }
				)

	annotation PBI_Id = 1908975e3c3544d28192ff6d6dc2a1b1

