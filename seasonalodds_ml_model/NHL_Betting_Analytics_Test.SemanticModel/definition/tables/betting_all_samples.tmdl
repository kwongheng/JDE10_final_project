table betting_all_samples
	lineageTag: b42b2508-b18b-4a21-b212-403fd03a64c0
	sourceLineageTag: [gold].[betting_all_samples]

	measure '1. Total Qualified Bets' = SUM('betting_season_tabulation'[Qualified_Bets_Offered])
		formatString: 0
		lineageTag: 98cc7427-de4b-4924-9a3a-12e0116f8a8c

	measure '2. Selective Accuracy %' = AVERAGE('betting_season_tabulation'[Selective_Accuracy_Pct])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: ab08af32-22f1-4894-ac71-3524e6151fd8

	measure '3. Avg EV %' = AVERAGE('betting_all_samples'[expected_value_pct])
		lineageTag: c658a67f-bb79-4644-aabd-3d0b73019146

	measure '4. High EV Bets Count' =
			CALCULATE(
			    COUNTROWS('betting_all_samples'),
			    'betting_all_samples'[expected_value_pct] >= 2.0
			)
		formatString: 0
		lineageTag: 4126a37c-3804-4bbe-81a3-b0ff881a0feb

	measure 'Committed Bets' = COUNTROWS('betting_all_samples')
		formatString: 0
		lineageTag: f3f96633-7553-487f-a1ee-30a33d31d8a3

	measure 'Winning Bets' =
			CALCULATE(
			    COUNTROWS('betting_all_samples'),
			    'betting_all_samples'[bet_outcome] = "WIN"
			)
		formatString: 0
		lineageTag: 7db0a18c-5fce-4e0d-b8e3-dd0fded3ae06

	measure 'Win Rate %' = DIVIDE([Winning Bets], [Committed Bets], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 30de5a1f-587e-4af9-ba47-1418254f0667

	measure 'Total Capital Spent' = [Committed Bets] * 10
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 59dd8c6f-ef23-4d45-9d34-cee9b0500634

	measure 'Total Return' =
			SUMX(
			    'betting_all_samples',
			    VAR Odds = 'betting_all_samples'[picked_odds]
			    VAR Outcome = 'betting_all_samples'[bet_outcome]
			    RETURN
			        IF(
			            Outcome = "WIN",
			            IF(
			                Odds < 0,
			                10 + (10 * (100 / ABS(Odds))),
			                10 + (10 * (Odds / 100))
			            ),
			            0
			        )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: bee82b80-83df-4c9b-9e47-0a987035a55b

	measure 'Total Net Gain' =
			SUMX(
			    'betting_all_samples',
			    VAR Odds = 'betting_all_samples'[picked_odds]
			    VAR Outcome = 'betting_all_samples'[bet_outcome]
			    VAR Payout =
			        IF(
			            Outcome = "WIN",
			            IF(Odds < 0, 10 + (10 * (100 / ABS(Odds))), 10 + (10 * (Odds / 100))),
			            0
			        )
			    RETURN Payout - 10
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8a964108-a603-46f8-afeb-9271ee4a9933

	measure 'ROI %' = DIVIDE([Total Net Gain], [Total Capital Spent], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 2b888640-acf0-4a1b-9e6b-acfd9a4ecab1

	measure 'Portfolio ROI %' = DIVIDE([Total Net Gain], [Total Capital Spent], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 93608bdb-13b7-4bbf-ba32-a8542747a781

	measure 'Overall Win Rate %' =
			VAR TotalBets = COUNTROWS('betting_all_samples')
			VAR TotalWins =
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			RETURN
			    DIVIDE(TotalWins, TotalBets, 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 463c5889-b025-4286-b931-ef40dc16df44

	measure 'Cumulative Net Gain' =
			CALCULATE(
			    [Total Net Gain],
			    FILTER(
			        ALLSELECTED('betting_all_samples'),
			        'betting_all_samples'[game_date] <= MAX('betting_all_samples'[game_date])
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: de91eb31-643b-4e87-98d5-d512afbda0ac

	measure 'Team Label Custom' =
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins =
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			VAR WinRate = DIVIDE(TotalWins, TotalCommitted, 0)
			RETURN
			    FORMAT(WinRate, "0.0%") & " (" & TotalWins & "/" & TotalCommitted & ")"
		lineageTag: a278dc60-7144-4dc8-ab28-59663aa6fd09

	measure 'Team Label Clean' =
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins =
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			VAR WinRate = DIVIDE(TotalWins, TotalCommitted, 0)
			RETURN
			    IF(
			        TotalCommitted > 0,
			        FORMAT(WinRate, "0.0%") & " (" & TotalWins & "/" & TotalCommitted & " Bets)",
			        BLANK()
			    )
		lineageTag: e284eb4d-7cf7-4f5b-a928-0f8aa6e6f8fe

	measure 'Team Net Gain' =
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalCapital = TotalCommitted * 10
			VAR TotalReturn =
			    SUMX(
			        'betting_all_samples',
			        VAR Odds = 'betting_all_samples'[picked_odds]
			        VAR Outcome = 'betting_all_samples'[bet_outcome]
			        RETURN
			            IF(
			                Outcome = "WIN",
			                IF(
			                    Odds < 0,
			                    10 + (10 * (100 / ABS(Odds))),
			                    10 + (10 * (Odds / 100))
			                ),
			                0
			            )
			    )
			RETURN
			    TotalReturn - TotalCapital
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 2672b56a-a504-4fbc-8817-67c574cbd11c

	measure 'Top Team Win Rate %' =
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins =
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			RETURN
			    DIVIDE(TotalWins, TotalCommitted, 0)
		lineageTag: 6c1216f3-ba50-4d53-b75b-8a8761ce20e1

	column Category
		dataType: string
		lineageTag: c39db490-d786-44ff-99bd-dd797ca90641
		sourceLineageTag: Category
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column game_id
		dataType: int64
		formatString: 0
		lineageTag: 500c4007-873f-41b9-8337-1f86ebe75794
		sourceLineageTag: game_id
		summarizeBy: sum
		sourceColumn: game_id

		annotation SummarizationSetBy = Automatic

	column game_date
		dataType: dateTime
		formatString: General Date
		lineageTag: 7ad6c027-46c9-4424-b4c9-6e7bdae0e63c
		sourceLineageTag: game_date
		summarizeBy: none
		sourceColumn: game_date

		annotation SummarizationSetBy = Automatic

	column home_team
		dataType: string
		lineageTag: 54ec3a9d-3ecd-45e0-b354-d5b5982dde6c
		sourceLineageTag: home_team
		summarizeBy: none
		sourceColumn: home_team

		annotation SummarizationSetBy = Automatic

	column away_team
		dataType: string
		lineageTag: 69ff1225-5e7e-4e33-8a8e-dce2b0966b30
		sourceLineageTag: away_team
		summarizeBy: none
		sourceColumn: away_team

		annotation SummarizationSetBy = Automatic

	column picked_side
		dataType: string
		lineageTag: b0ffc07e-5220-4b95-9cb2-cb6d30e19c01
		sourceLineageTag: picked_side
		summarizeBy: none
		sourceColumn: picked_side

		annotation SummarizationSetBy = Automatic

	column picked_odds
		dataType: int64
		formatString: 0
		lineageTag: 016c8c80-3125-4ca4-8fa4-b5833489eaaf
		sourceLineageTag: picked_odds
		summarizeBy: sum
		sourceColumn: picked_odds

		annotation SummarizationSetBy = Automatic

	column model_prob
		dataType: double
		lineageTag: 1f84e0d6-872b-4996-bbb8-64fef873b1d1
		sourceLineageTag: model_prob
		summarizeBy: sum
		sourceColumn: model_prob

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column book_prob
		dataType: double
		lineageTag: f49d9878-af27-441c-a958-d85a0e70a367
		sourceLineageTag: book_prob
		summarizeBy: sum
		sourceColumn: book_prob

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column confidence_metric
		dataType: double
		lineageTag: e724a80b-8f8b-49dd-8b87-cfe687727643
		sourceLineageTag: confidence_metric
		summarizeBy: sum
		sourceColumn: confidence_metric

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column expected_value_pct
		dataType: double
		lineageTag: ae3716ff-e0b4-4291-8b45-7ea838a099b2
		sourceLineageTag: expected_value_pct
		summarizeBy: sum
		sourceColumn: expected_value_pct

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column bet_outcome
		dataType: string
		lineageTag: 0133218d-5304-407d-b6fa-1d0403cfae03
		sourceLineageTag: bet_outcome
		summarizeBy: none
		sourceColumn: bet_outcome

		annotation SummarizationSetBy = Automatic

	column EV_Tier =
			SWITCH(
			    TRUE(),
			    'betting_all_samples'[expected_value_pct] >= 15.0, "Massive Value (+15%+)",
			    'betting_all_samples'[expected_value_pct] >= 5.0,  "High Value (+5% to +15%)",
			    'betting_all_samples'[expected_value_pct] >= 2.0,  "Moderate Value (+2% to +5%)",
			    'betting_all_samples'[expected_value_pct] < 2.0, "Low/Negative Edge (< +2%)"
			)
		lineageTag: f83c3496-28f7-498a-ad1d-c9e4c375ff48
		summarizeBy: none
		expressionContext: userContext

	column EV_Category =
			SWITCH(
			    TRUE(),
			    'betting_all_samples'[expected_value_pct] >= 15.0, "🟢 Massive Edge (+15%+ EV)",
			    'betting_all_samples'[expected_value_pct] >= 2.0,  "🟡 Good Edge (+2% to +15% EV)",
			    "🔴 Low / No Edge (< +2% EV)"
			)
		lineageTag: 853ce170-20cb-478c-84eb-c7045a244e7b
		summarizeBy: none
		expressionContext: userContext

	column Bet_Category_Label =
			SWITCH(
			    TRUE(),
			    'betting_all_samples'[Category] = "Moneyline (Home Win)", "Moneyline (Home Win)",
			    'betting_all_samples'[Category] = "Puck Line (Home +1.5)", "Puckline (Home +1.5)",
			    'betting_all_samples'[Category] = "Totals (Over 5.5)", "Totals (Over 5.5)",
			    CONTAINSSTRING('betting_all_samples'[picked_side], "+1.5") || CONTAINSSTRING('betting_all_samples'[picked_side], "-1.5"), "Puckline (Home +1.5)",
			    CONTAINSSTRING('betting_all_samples'[picked_side], "OVER") || CONTAINSSTRING('betting_all_samples'[picked_side], "UNDER"), "Totals (Over 5.5)",
			    "Moneyline (Home Win)"
			)
		lineageTag: 2b49763a-83ba-44ab-b248-ab042b5b8bef
		summarizeBy: none
		expressionContext: userContext

	column EV_Decimal = 'betting_all_samples'[expected_value_pct] / 100
		lineageTag: 62063908-93f4-403c-9928-5e674a52b734
		summarizeBy: sum
		expressionContext: userContext

	column Odds_Band =
			SWITCH(
			    TRUE(),
			    'betting_all_samples'[picked_odds] < -150, "1. Heavy Favorite (<-150)",
			    'betting_all_samples'[picked_odds] <= 100, "2. Slight Favorite (-150 to +100)",
			    'betting_all_samples'[picked_odds] <= 150, "3. Moderate Underdog (+101 to +150)",
			    "4. High Underdog (>+150)"
			)
		lineageTag: b4c58c06-0d1a-416b-baf2-5924b8f183c2
		summarizeBy: none
		expressionContext: userContext

	column EV_Tier_Expanded =
			VAR EV = 'betting_all_samples'[EV_Decimal]
			RETURN
			    SWITCH(
			        TRUE(),
			        EV >= 0.15, "1. Elite Edge (>=15%)",
			        EV >= 0.10, "2. Strong Edge (10-14.9%)",
			        EV >= 0.05, "3. Moderate Edge (5-9.9%)",
			        EV >= 0.00, "4. Low Edge (0-4.9%)",
			        "5. Negative EV (<0%)"
			    )
		lineageTag: 23c59b3d-f7d1-4cc8-9b94-74072a1ccd34
		summarizeBy: none
		expressionContext: userContext

	partition betting_all_samples = entity
		mode: directLake
		source
			entityName: betting_all_samples
			schemaName: gold
			expressionSource: 'DirectLake - NHL_data'

