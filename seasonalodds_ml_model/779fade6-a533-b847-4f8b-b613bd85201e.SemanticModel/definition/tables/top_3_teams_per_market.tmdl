table top_3_teams_per_market
	lineageTag: 3955b59c-466a-4643-aad4-e565c5822bd1
	sourceLineageTag: [gold].[top_3_teams_per_market]

	measure 'Team Win Rate %' =
			
			VAR RawWinRate = AVERAGE('top_3_teams_per_market'[Win_Rate_Pct])
			RETURN
			    IF(
			        RawWinRate > 1,
			        RawWinRate / 100,  // Converts 83.3 into 0.833 for proper % formatting
			        RawWinRate
			    )
		lineageTag: 8bf82a5d-3590-446a-aaae-b111bf95cc66

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

