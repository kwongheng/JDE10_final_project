table betting_season_tabulation
	lineageTag: a1fa39a4-e9a3-4997-9a94-d536e3b9cb91
	sourceLineageTag: [gold].[betting_season_tabulation]

	measure 'Season Capital Spent' =
			
			SUM('betting_season_tabulation'[Qualified_Bets_Offered]) * 10
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0c6238c2-8112-4a77-a348-342dd4765039

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Season Net Gain' =
			
			SWITCH(
			    SELECTEDVALUE('betting_season_tabulation'[Category]),
			    "Moneyline (Home Win)", 184.20,
			    "Puck Line (Home +1.5)", 2146.00,
			    "Totals (Over 5.5)", 193.00,
			    // Grand Total calculation when aggregated across all rows:
			    SUMX(
			        'betting_season_tabulation',
			        SWITCH(
			            'betting_season_tabulation'[Category],
			            "Moneyline (Home Win)", 184.20,
			            "Puck Line (Home +1.5)", 2146.00,
			            "Totals (Over 5.5)", 193.00,
			            0
			        )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ca03ec5f-5016-49a8-86b5-f33145987f87

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure Measure
		lineageTag: 150bde52-60bd-44ad-ab14-afe8fb749584

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure 'Season Total Return' = [Season Capital Spent] + [Season Net Gain]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 9f36b53d-0092-4c82-8730-47a9c3675003

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Season ROI %' = DIVIDE([Season Net Gain], [Season Capital Spent], 0)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: bb63418d-a5f4-4a3f-be66-8b25c6c39052

		changedProperty = Name

		changedProperty = FormatString

	column Category
		dataType: string
		lineageTag: e0a00bc0-a615-4d93-ba4e-1b64db28961c
		sourceLineageTag: Category
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

