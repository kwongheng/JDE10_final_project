table betting_season_tabulation
	lineageTag: 6918eef7-e079-4160-bb56-6c672e49f237
	sourceLineageTag: [gold].[betting_season_tabulation]

	measure 'Season Capital Spent' = SUM('betting_season_tabulation'[Qualified_Bets_Offered]) * 10
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: f81b878c-49eb-41de-8c18-346babe9ee01

	measure 'Season Net Gain' =
			SWITCH(
			    SELECTEDVALUE('betting_season_tabulation'[Category]),
			    "Moneyline (Home Win)", 184.20,
			    "Puck Line (Home +1.5)", 2146.00,
			    "Totals (Over 5.5)", 193.00,
			    SUMX(
			        'betting_season_tabulation',
			        SWITCH(
			            'betting_season_tabulation'[Category],
			            "Moneyline (Home Win)", 184.20,
			            "Puck Line (Home +1.5)", 2146.00,
			            "Totals (Over 5.5)", 193.00,
			            0
			        )
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: ed13fbe5-d9b2-414b-a17d-98602fd43d8b

	measure 'Season Total Return' = [Season Capital Spent] + [Season Net Gain]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 8b0afe54-8eba-4bf4-a900-9ccd39aeb2d6

	measure 'Season ROI %' = DIVIDE([Season Net Gain], [Season Capital Spent], 0)
		formatString: #,0.00%;-#,0.00%;#,0.00%
		lineageTag: aba46051-b894-472a-b285-708cc13bec7b

	column Category
		dataType: string
		lineageTag: 7b29d071-3e64-4099-ac50-44c9c4936baf
		sourceLineageTag: Category
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Total_Season_Games
