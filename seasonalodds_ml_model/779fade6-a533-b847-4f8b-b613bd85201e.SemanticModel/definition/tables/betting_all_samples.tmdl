table betting_all_samples
	lineageTag: 9bde599a-797c-4b27-b7a0-eaf0f0188099
	sourceLineageTag: [gold].[betting_all_samples]

	measure '1. Total Qualified Bets' =
			
			SUM('betting_season_tabulation'[Qualified_Bets_Offered])
		formatString: 0
		lineageTag: 625b9020-8a02-4ebc-a570-8e1d0e8da779

		changedProperty = Name

	measure '2. Selective Accuracy %' =
			
			AVERAGE('betting_season_tabulation'[Selective_Accuracy_Pct])
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bcd3be75-e4c6-45bd-b346-d271e21e6cb8

		changedProperty = Name

		changedProperty = FormatString

	measure '3. Avg EV %' =
			
			AVERAGE('betting_all_samples'[expected_value_pct])
		lineageTag: 78a6081a-e220-409b-9820-89a07059a776

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '4. High EV Bets Count' = ```
			
			CALCULATE(
			    COUNTROWS('betting_all_samples'), 
			    'betting_all_samples'[expected_value_pct] >= 2.0
			)
			```
		formatString: 0
		lineageTag: 8a2dee57-3643-4fbe-ac00-80da65acaba1

		changedProperty = Name

	measure 'Total Capital Spent' = [Committed Bets] * 10
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 5d7d284d-2423-4f35-86f9-b46d17188330

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Return' =
			
			SUMX(
			    'betting_all_samples',
			    VAR Odds = 'betting_all_samples'[picked_odds]
			    VAR Outcome = 'betting_all_samples'[bet_outcome]
			    RETURN
			        IF(
			            Outcome = "WIN",
			            IF(
			                Odds < 0,
			                10 + (10 * (100 / ABS(Odds))),  // Favorite payout
			                10 + (10 * (Odds / 100))        // Underdog payout
			            ),
			            0                                   // LOSS yields $0 return
			        )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 0934215a-7c7b-4ed0-8e24-1d1612307070

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Total Net Gain' = ```
			
			SUMX(
			    'betting_all_samples',
			    VAR Odds = 'betting_all_samples'[picked_odds]
			    VAR Outcome = 'betting_all_samples'[bet_outcome]
			    VAR Payout = 
			        IF(
			            Outcome = "WIN",
			            IF(Odds < 0, 10 + (10 * (100 / ABS(Odds))), 10 + (10 * (Odds / 100))),
			            0
			        )
			    RETURN Payout - 10
			)
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: edfe45e6-8dd7-496a-a422-dbc158592c63

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'ROI %' = DIVIDE([Total Net Gain], [Total Capital Spent], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: c3006eae-6b95-4522-8914-55e2806af388

		changedProperty = Name

		changedProperty = FormatString

	measure 'Team Label Custom' = ```
			
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins = 
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			VAR WinRate = DIVIDE(TotalWins, TotalCommitted, 0)
			RETURN
			    FORMAT(WinRate, "0.0%") & " (" & TotalWins & "/" & TotalCommitted & ")"
			```
		lineageTag: 756e59e0-80bc-462b-8646-0d343d8e1a7c

		changedProperty = Name

	measure 'Team Net Gain' = ```
			
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalCapital = TotalCommitted * 10
			VAR TotalReturn = 
			    SUMX(
			        'betting_all_samples',
			        VAR Odds = 'betting_all_samples'[picked_odds]
			        VAR Outcome = 'betting_all_samples'[bet_outcome]
			        RETURN
			            IF(
			                Outcome = "WIN",
			                IF(
			                    Odds < 0,
			                    10 + (10 * (100 / ABS(Odds))),
			                    10 + (10 * (Odds / 100))
			                ),
			                0
			            )
			    )
			RETURN
			    TotalReturn - TotalCapital
			```
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 43defd21-8291-4212-97a4-a9c57611d395

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Top Team Win Rate %' = ```
			
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins = 
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			RETURN
			    DIVIDE(TotalWins, TotalCommitted, 0)
			```
		lineageTag: 83dfca66-e91b-4bf4-9d75-b2d67ea849a8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Team Label Clean' = ```
			
			VAR TotalCommitted = COUNTROWS('betting_all_samples')
			VAR TotalWins = 
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			VAR WinRate = DIVIDE(TotalWins, TotalCommitted, 0)
			RETURN
			    IF(
			        TotalCommitted > 0,
			        FORMAT(WinRate, "0.0%") & " (" & TotalWins & "/" & TotalCommitted & " Bets)",
			        BLANK()
			    )
			```
		lineageTag: a0211c1a-fee0-4785-b9bb-3857bd5adcd0

		changedProperty = Name

	measure 'Cumulative Net Gain' =
			
			CALCULATE(
			    [Total Net Gain],
			    FILTER(
			        ALLSELECTED('betting_all_samples'),
			        'betting_all_samples'[game_date] <= MAX('betting_all_samples'[game_date])
			    )
			)
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 901c7bb4-79a3-48d8-8ac7-2f1bf8e70146

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Overall Win Rate %' = ```
			
			VAR TotalBets = COUNTROWS('betting_all_samples')
			VAR TotalWins = 
			    CALCULATE(
			        COUNTROWS('betting_all_samples'),
			        'betting_all_samples'[bet_outcome] = "WIN"
			    )
			RETURN
			    DIVIDE(TotalWins, TotalBets, 0)
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 18bbd02d-86a4-497f-8bf5-999b11c81554

		changedProperty = Name

		changedProperty = FormatString

	measure 'Portfolio ROI %' =
			
			DIVIDE([Total Net Gain], [Total Capital Spent], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 45777b97-a03a-4a86-9d7e-f665ef47b784

		changedProperty = Name

		changedProperty = FormatString

	measure 'Committed Bets' = COUNTROWS('betting_all_samples')
		formatString: 0
		lineageTag: e9bbb0f1-60eb-424a-82db-3cee8205045e

		changedProperty = Name

	measure 'Winning Bets' =
			
			CALCULATE(
			    COUNTROWS('betting_all_samples'),
			    'betting_all_samples'[bet_outcome] = "WIN"
			)
		formatString: 0
		lineageTag: 8dded691-3297-4ad9-b4c6-bc558673719e

		changedProperty = Name

	measure 'Win Rate %' = DIVIDE([Winning Bets], [Committed Bets], 0)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: d8745b10-e24d-4ff6-90e1-a6934fcfbbf6

