table betting_summary_unpivoted
	lineageTag: c54ddc1b-6e4f-43e3-b3fb-86236b2c1d9a
	sourceLineageTag: [gold].[betting_summary_unpivoted]

	measure 'Team Total Committed Bets' =
			
			CALCULATE(
			    COUNTROWS('betting_summary_unpivoted'),
			    REMOVEFILTERS('betting_summary_unpivoted'[Category])  // Aggregates ML, Puck Line & Totals together
			)
		formatString: 0
		lineageTag: 6f1167b8-33d6-4b95-baaf-d8ee56f2b909

		changedProperty = Name

	measure 'Team Executive Label' =
			
			VAR TotalBets = [Team Total Committed Bets]
			VAR WinRate = [Team Win Rate %]
			VAR NetGain = [Total Net Gain $]
			RETURN
			    IF(
			        TotalBets >= 5,
			        FORMAT(WinRate, "0.0%") & " (" & TotalBets & " Bets | Net: " & FORMAT(NetGain, "$#,##0") & ")",
			        BLANK()
			    )
		lineageTag: eb3df81a-e547-4e77-87a7-fa2109bfea2b

		changedProperty = Name

	column Category
		dataType: string
		lineageTag: 16d87767-1d6d-43cf-853f-c9de7771dbb1
		sourceLineageTag: Category
		summarizeBy: none
		sourceColumn: Category

		annotation SummarizationSetBy = Automatic

	column Metric_Name
		dataType: string
		lineageTag: 8fc7cbd9-3926-49b1-ad26-7390be764301
		sourceLineageTag: Metric_Name
		summarizeBy: none
		sourceColumn: Metric_Name

		annotation SummarizationSetBy = Automatic

	column Game_Count
		dataType: int64
		formatString: 0
		lineageTag: 722310d4-5c5e-417e-932e-179670241606
		sourceLineageTag: Game_Count
		summarizeBy: sum
		sourceColumn: Game_Count

		annotation SummarizationSetBy = Automatic

	column Metric_Group
		dataType: string
		lineageTag: fa1f0d72-d691-47b6-8179-cd468995e831
		sourceLineageTag: Metric_Group
		summarizeBy: none
		sourceColumn: Metric_Group

		annotation SummarizationSetBy = Automatic

	partition betting_summary_unpivoted = entity
		mode: directLake
		source
			entityName: betting_summary_unpivoted
			schemaName: gold
			expressionSource: 'DirectLake - NHL_db'

